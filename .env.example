# Environment Variables for Heroes of the Islam

# ==========================================
# 1. AI API Configuration (Optional / Runtime)
# ==========================================
# GEMINI_API_KEY: Required if invoking Google Gemini AI features server-side.
# In Vercel: Project Settings -> Environment Variables -> Add GEMINI_API_KEY
# In Netlify: Site configuration -> Environment variables -> Add GEMINI_API_KEY
GEMINI_API_KEY="your-gemini-api-key-here"

# ==========================================
# 2. Host Application URL
# ==========================================
# APP_URL: The public production URL of your deployment.
# In Vercel: https://your-project.vercel.app
# In Netlify: https://your-project.netlify.app
APP_URL="https://your-domain.com"

# ==========================================
# 3. Build & Container Flags (Optional)
# ==========================================
# NEXT_OUTPUT_STANDALONE: Set to "true" only if building a standalone Docker image.
# Leave unset or "false" for Vercel and Netlify native serverless deployment.
NEXT_OUTPUT_STANDALONE="false"
